# Copy this file to .env and fill in the values.

# Long random secret for the iOS Shortcut. Generate one with:
#   openssl rand -hex 32
UPLOAD_TOKEN=

# Where the database and media live on the host. Leave empty for ./data.
#   FEED_DATA_DIR=/mnt/projects/feed-data
FEED_DATA_DIR=

# From Cloudflare: Zero Trust > Networks > Tunnels > your tunnel > install
# command. Copy only the long token after "--token".
TUNNEL_TOKEN=
